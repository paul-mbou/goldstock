# Supabase project (Project Settings → API). While either value is unset, login and signup
# open the demo dashboard without an account.
# The publishable key (sb_publishable_…) or the legacy anon key both work; never put the
# secret / service_role key here, it would ship to every browser.
# PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
#
# On Vercel, the Supabase integration often creates NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY instead. The app accepts those names as a fallback.
# Prefer the PUBLIC_* names above so local and production stay identical.
