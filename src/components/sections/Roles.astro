---
import { BriefcaseBusiness, Check, Crown, LockKeyhole, Package, ShoppingCart } from 'lucide-react';
import { roles } from '../../data/site';

const icons = {
  owner: Crown,
  manager: BriefcaseBusiness,
  seller: ShoppingCart,
  storekeeper: Package,
} as const;
---

<section
  id="acces"
  aria-labelledby="roles-title"
  class="relative isolate overflow-hidden bg-navy-950 py-20 text-white lg:py-28"
>
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(50rem_26rem_at_50%_0%,rgb(37_99_235/0.18),transparent_65%),radial-gradient(36rem_22rem_at_50%_110%,rgb(244_181_44/0.12),transparent_65%)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(rgb(255_255_255/0.03)_1px,transparent_1px),linear-gradient(90deg,rgb(255_255_255/0.03)_1px,transparent_1px)] mask-[radial-gradient(ellipse_at_center,black,transparent_75%)] bg-size-[64px_64px]"></div>
  </div>

  <div class="container-page">
    <div data-reveal-stagger class="mx-auto max-w-2xl text-center">
      <p class="inline-flex items-center rounded-full bg-gold-400/10 px-3 py-1 text-xs font-bold tracking-wider text-gold-300 uppercase ring-1 ring-gold-400/25">
        Types d’accès
      </p>
      <h2
        id="roles-title"
        class="mt-4 text-3xl leading-tight font-extrabold tracking-[-0.02em] text-balance sm:text-4xl"
      >
        Chaque collaborateur voit ce qui le concerne
      </h2>
      <p class="mt-4 text-lg text-pretty text-white/65">
        Attribuez un rôle à chaque membre de l’équipe. Marges, caisse et facturation restent sous votre contrôle.
      </p>
    </div>

    <ul
      data-reveal-stagger
      class="mt-14 grid gap-5 [--reveal-delay:150ms] [--reveal-step:110ms] sm:grid-cols-2 lg:grid-cols-4"
    >
      {roles.map(({ icon, name, summary, permissions }) => {
        const Icon = icons[icon];
        const owner = icon === 'owner';
        return (
          <li
            class:list={[
              'rounded-2xl bg-white p-6 text-navy-900 shadow-[0_24px_48px_-24px_rgb(2_8_20/0.6)] transition duration-300 hover:-translate-y-1',
              owner && 'ring-2 ring-gold-400',
            ]}
          >
            <div class="flex items-center gap-4">
              <span
                class:list={[
                  'grid size-12 shrink-0 place-items-center rounded-xl',
                  owner
                    ? 'bg-linear-to-b from-gold-300 to-gold-500 text-navy-950 shadow-[0_8px_20px_-8px_rgb(232_157_18/0.7)]'
                    : 'border border-gold-200/80 bg-linear-to-b from-gold-50 to-gold-100/70 text-gold-600',
                ]}
              >
                <Icon className="size-[1.375rem]" strokeWidth={2} aria-hidden="true" />
              </span>
              <div>
                <h3 class="text-lg font-extrabold">{name}</h3>
                <p class="text-sm text-navy-500">{summary}</p>
              </div>
            </div>

            <ul class="mt-5 space-y-3 border-t border-navy-100 pt-5 text-sm">
              {permissions.map(({ label, allowed }) => (
                <li class:list={['flex items-center gap-3', allowed ? 'text-navy-800' : 'text-navy-500']}>
                  {allowed ? (
                    <Check className="size-4 shrink-0 text-emerald-500" strokeWidth={3} aria-hidden="true" />
                  ) : (
                    <LockKeyhole className="size-4 shrink-0 text-navy-400" aria-hidden="true" />
                  )}
                  <span>
                    {label}
                    <span class="sr-only">{allowed ? ' : autorisé' : ' : non autorisé'}</span>
                  </span>
                </li>
              ))}
            </ul>
          </li>
        );
      })}
    </ul>

    <p data-reveal="fade" class="mt-10 text-center text-sm text-white/50 [--reveal-delay:400ms]">
      Permissions et plafonds de remise ajustables. Proposition par défaut, modifiable à tout moment.
    </p>
  </div>
</section>
